# A free sandbox key: npx billos sandbox   (then: npx billos env >> .env)
BILLOS_API_KEY=
# npx billos businesses   (or: npx billos seed, for a demo business in the sandbox)
BILLOS_BUSINESS_ID=

# One secret per source you receive from. Leave the others empty.
STRIPE_WEBHOOK_SECRET=      # the endpoint's signing secret, whsec_…
STRIPE_SECRET_KEY=          # optional: prints the session's line items on the document
WOOCOMMERCE_WEBHOOK_SECRET= # the Secret of the webhook in WooCommerce > Settings > Advanced > Webhooks
SHOPIFY_WEBHOOK_SECRET=     # the app's client secret
PAYPLUS_WEBHOOK_SECRET=     # your PayPlus API secret key

# These three sign nothing, so the secret rides in the address you give them:
#   https://shop.example.com/hooks/tranzila?key=<the secret>
TRANZILA_WEBHOOK_SECRET=
CARDCOM_WEBHOOK_SECRET=
GROW_WEBHOOK_SECRET=

# Tranzila, optional: read every notified transaction back before issuing.
TRANZILA_TERMINAL=
TRANZILA_APP_KEY=
TRANZILA_SECRET=
# CardCom: the result is always read back from LowProfile/GetLpResult.
CARDCOM_TERMINAL=
CARDCOM_API_NAME=
