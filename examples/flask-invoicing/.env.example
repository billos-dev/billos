# A key starts with bk_test_ (sandbox) or bk_live_ (real, permanent tax documents).
# A free sandbox key:  npx billos sandbox   (prints a link; you sign in and approve it once)
BILLOS_API_KEY=bk_test_...

# The business to issue from. Optional while the key holds exactly one business, and in an
# empty sandbox (a demo business is created on first start).
BILLOS_BUSINESS_ID=

# The signing secret of your webhook endpoint (whsec_...), shown when the endpoint is created.
BILLOS_WEBHOOK_SECRET=

# Optional.
# BILLOS_BASE_URL=https://api.billos.co.il/v1
